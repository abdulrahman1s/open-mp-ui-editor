{
  "user": "abdulrahman1s",
  "repo": "open-mp-ui-editor",
  "include_path": "pawn/include",
  "entry": "pawn/examples/quickstart.pwn",
  "output": "artifacts/quickstart.amx",
  "dependencies": [
    "openmultiplayer/omp-stdlib"
  ],
  "builds": [
    {
      "name": "example",
      "entry": "pawn/examples/quickstart.pwn"
    }
  ],
  "resources": [
    {
      "name": "^open-mp-ui-editor-[0-9.]+-linux-x86\\.zip$",
      "platform": "linux",
      "archive": true,
      "includes": [
        "pawn/include"
      ],
      "plugins": [
        "components/open-mp-ui-editor.so"
      ]
    },
    {
      "name": "^open-mp-ui-editor-[0-9.]+-windows-x86\\.zip$",
      "platform": "windows",
      "archive": true,
      "includes": [
        "pawn/include"
      ],
      "plugins": [
        "components/open-mp-ui-editor.dll"
      ]
    }
  ]
}
